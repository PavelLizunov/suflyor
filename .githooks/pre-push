#!/bin/sh
# Agent-agnostic selective gate: docs-only, affected crate, or full CI.
root="$(git rev-parse --show-toplevel)" || exit 1
if [ "$(uname -s)" = "Darwin" ]; then
    exec bash "$root/scripts/git-gate-macos.sh"
fi
if command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/git-gate-native.ps1" push
elif command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/git-gate-native.ps1" push
else
    # Linux control plane / non-PowerShell environments: verify no unstaged or diff errors
    git diff --check origin/master...HEAD
fi
