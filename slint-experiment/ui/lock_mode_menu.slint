import { Theme } from "theme.slint";
import { Metrics } from "metrics.slint";
import { LockModeMenuRow } from "overlay_bar.slint";

// A real top-level window: unlike PopupWindow inside OverlayBarWindow it is
// not clipped by the bar's deliberately small 64px client rectangle.
export component LockModeMenuWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: @tr("Auto-tiles");
    background: transparent;
    preferred-width: 320px;
    preferred-height: 106px;
    in property <int> mode: 1;
    callback mode-selected(int);
    callback dismissed();
    forward-focus: scope;

    scope := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        Rectangle {
            background: Theme.bg-elevated;
            border-color: Theme.border-strong;
            border-width: Metrics.border-thin;
            border-radius: Metrics.radius-control;
            VerticalLayout {
                padding: Metrics.space-xs;
                spacing: 2px;
                LockModeMenuRow {
                    label: @tr("Silent: no automatic tiles");
                    current: root.mode == 0;
                    mode-color: Theme.warning;
                    icon: @image-url("../assets/icons/lock.svg");
                    clicked => { root.mode-selected(0); }
                }
                LockModeMenuRow {
                    label: @tr("On questions");
                    current: root.mode == 1;
                    mode-color: Theme.text-secondary;
                    icon: @image-url("../assets/icons/unlock.svg");
                    clicked => { root.mode-selected(1); }
                }
                LockModeMenuRow {
                    label: @tr("On every line");
                    current: root.mode == 2;
                    mode-color: Theme.cat-orange;
                    icon: @image-url("../assets/icons/flame.svg");
                    clicked => { root.mode-selected(2); }
                }
            }
        }
    }
}
