import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Metrics } from "metrics.slint";

struct MenuRow { id: string, icon: image, name: string, key: string, head: bool, pinnable: bool, active: bool }

// Separate native window: the bar's 64px client rectangle cannot host a popup.
export component BarMenuWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: @tr("More");
    preferred-width: 408px;
    preferred-height: 330px + (root.tray-available ? 28px : 0px) + (root.lock-menu-managed ? 28px : 0px) + root.footer-height;
    property <bool> widgets-light: Theme.is-light;
    init => { Palette.color-scheme = root.widgets-light ? ColorScheme.light : ColorScheme.dark; }
    changed widgets-light => { Palette.color-scheme = root.widgets-light ? ColorScheme.light : ColorScheme.dark; }

    in property <[string]> pins;
    in property <bool> lock-menu-managed;
    in property <bool> deep-lock;
    in property <bool> can-restore-tile;
    in property <bool> tray-available;
    in property <bool> settings-open;
    in property <bool> archive-open;
    in property <bool> help-open;
    in property <bool> summary-busy;
    in-out property <string> confirmation: "";
    property <int> inactive-ticks: 0;
    property <int> pin-error-ticks: 0;
    out property <length> footer-height: root.pin-error-ticks > 0 ? 24px : 0px;
    callback footer-resized();
    changed footer-height => { root.footer-resized(); }
    callback pin-save-failed();
    pin-save-failed => { root.pin-error-ticks = 40; }
    Timer {
        interval: 100ms;
        running: root.pin-error-ticks > 0;
        triggered => { root.pin-error-ticks -= 1; }
    }
    callback action(string);
    callback pin-toggled(string);
    callback dismissed();

    // Strict grid shared by every row, including empty and confirmation cells.
    property <length> col-pad: 8px;
    property <length> col-icon: 14px;
    property <length> col-gap: 8px;
    property <length> col-key: 96px;
    property <length> col-pin: 78px;
    property <[MenuRow]> rows: [
        { name: @tr("TILES"), head: true },
        { id: "capture", icon: @image-url("../assets/icons/camera.svg"), name: @tr("Ask about a screenshot"), key: "F8", pinnable: true },
        { id: "restore", icon: @image-url("../assets/icons/restore.svg"), name: @tr("Restore closed tile"), pinnable: true },
        { name: @tr("MEETING"), head: true },
        { id: "archive", icon: @image-url("../assets/icons/archive.svg"), name: @tr("Session archive"), key: "F7", pinnable: true, active: root.archive-open },
        { id: "summary", icon: @image-url("../assets/icons/summary.svg"), name: @tr("Meeting summary"), pinnable: true, active: root.summary-busy },
        { id: "kb", icon: @image-url("../assets/icons/kb.svg"), name: @tr("Knowledge base"), key: "F4", pinnable: true },
        { name: @tr("APP"), head: true },
        { id: "settings", icon: @image-url("../assets/icons/gear.svg"), name: @tr("Settings"), pinnable: true, active: root.settings-open },
        { id: "help", icon: @image-url("../assets/icons/sos.svg"), name: @tr("Help"), key: "F1", pinnable: true, active: root.help-open },
        { id: "tray", icon: @image-url("../assets/icons/tray.svg"), name: @tr("Hide to tray"), pinnable: true },
        { id: "unload_ai", icon: @image-url("../assets/icons/lock.svg"), name: root.deep-lock ? @tr("Load local AI") : @tr("Unload local AI"), pinnable: false, active: root.deep-lock },
        { id: "restart", icon: @image-url("../assets/icons/restart.svg"), name: @tr("Restart"), pinnable: false },
        { id: "quit", icon: @image-url("../assets/icons/x.svg"), name: @tr("Quit"), pinnable: false },
    ];
    pure function is-pinned(id: string) -> bool {
        return (root.pins.length > 0 && root.pins[0] == id)
            || (root.pins.length > 1 && root.pins[1] == id)
            || (root.pins.length > 2 && root.pins[2] == id)
            || (root.pins.length > 3 && root.pins[3] == id)
            || (root.pins.length > 4 && root.pins[4] == id)
            || (root.pins.length > 5 && root.pins[5] == id)
            || (root.pins.length > 6 && root.pins[6] == id)
            || (root.pins.length > 7 && root.pins[7] == id);
    }
    function choose(id: string) {
        root.inactive-ticks = 0;
        if (id == "restart" || id == "quit") {
            root.confirmation = id;
        } else if (id != "restore" || root.can-restore-tile) {
            root.confirmation = "";
            root.action(id);
        }
    }
    Timer {
        interval: 100ms;
        running: root.confirmation != "";
        triggered => {
            root.inactive-ticks += 1;
            if (root.inactive-ticks >= 40) { root.confirmation = ""; }
        }
    }
    forward-focus: scope;
    scope := FocusScope {
        key-pressed(e) => {
            root.inactive-ticks = 0;
            if (e.text == Key.Escape) {
                if (root.confirmation != "") { root.confirmation = ""; }
                root.dismissed();
                return accept;
            }
            return reject;
        }
        Rectangle {
            background: Theme.bg-elevated;
            border-color: Theme.border-strong;
            border-width: Metrics.border-thin;
            border-radius: Metrics.radius-panel;
            VerticalLayout {
                padding: 6px;
                spacing: 0px;
                alignment: start;
                for r in root.rows : VerticalLayout {
                    alignment: start;
                    if (r.id != "tray" || root.tray-available) && (r.id != "unload_ai" || root.lock-menu-managed) : Rectangle {
                        property <bool> pinned: !r.head && root.is-pinned(r.id);
                        height: r.head ? 22px : 28px;
                        opacity: r.id == "restore" && !root.can-restore-tile ? 0.35 : 1;
                        border-radius: Metrics.radius-control;
                        background: row-touch.pressed ? Theme.tint(Theme.accent)
                            : row-touch.has-hover ? Theme.border-strong.with-alpha(0.22)
                            : self.pinned ? Theme.accent.with-alpha(0.10) : transparent;
                        HorizontalLayout {
                            padding-left: root.col-pad; padding-right: root.col-pad; spacing: root.col-gap;
                            if !r.head : Rectangle {
                                width: root.col-icon;
                                Image {
                                    source: r.icon;
                                    colorize: r.id == "quit" ? Theme.danger : r.active ? Theme.accent : Theme.text-secondary;
                                    width: parent.width; height: root.col-icon;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            if r.head : Text {
                                text: r.name;
                                font-size: Metrics.font-caption; color: Theme.text-muted;
                                vertical-alignment: center; horizontal-stretch: 1;
                                overflow: elide; min-width: 0px;
                            }
                            if !r.head : Rectangle {
                                horizontal-stretch: 1; min-width: 0px;
                                accessible-role: button;
                                accessible-label: r.name;
                                accessible-checkable: r.id == "unload_ai";
                                accessible-checked: r.id == "unload_ai" && root.deep-lock;
                                accessible-action-default => { root.choose(r.id); }
                                row-name := Text {
                                    x: 0px; y: 0px;
                                    width: parent.width; height: parent.height;
                                    horizontal-alignment: left;
                                    text: root.confirmation == r.id
                                        ? (r.id == "quit" ? @tr("Quit?") : @tr("Restart?")) : r.name;
                                    accessible-role: text;
                                    accessible-label: self.text + "."; // Distinct from the name cell's action.
                                    font-size: Metrics.font-body;
                                    color: r.id == "quit" ? Theme.danger : Theme.text-primary;
                                    vertical-alignment: center; overflow: elide; min-width: 0px;
                                }
                            }
                            if !r.head : Rectangle {
                                width: root.col-key;
                                if root.confirmation == r.id : Rectangle {
                                    height: 24px; x: 0px; y: (parent.height - self.height) / 2;
                                    width: parent.width; border-radius: Metrics.radius-field;
                                    background: Theme.danger;
                                    accessible-role: button; accessible-label: @tr("Yes");
                                    accessible-action-default => { root.confirmation = ""; root.action(r.id); }
                                    Text { text: @tr("Yes"); color: Theme.bg-surface; font-size: Metrics.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        moved => { root.inactive-ticks = 0; }
                                        clicked => { root.confirmation = ""; root.action(r.id); }
                                    }
                                }
                                if root.confirmation != r.id && r.key != "" : Rectangle {
                                    height: 20px; y: (parent.height - self.height) / 2;
                                    width: min(kt.preferred-width + 14px, parent.width);
                                    x: parent.width - self.width;
                                    border-radius: Metrics.radius-keycap;
                                    border-width: 1px; border-color: Theme.border;
                                    background: Theme.bg-surface;
                                    kt := Text { text: r.key; font-family: Theme.font-mono; font-size: Metrics.font-caption; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            if !r.head : Rectangle {
                                width: root.col-pin;
                                if root.confirmation == r.id : Rectangle {
                                    height: 24px; x: 0px; y: (parent.height - self.height) / 2;
                                    width: parent.width; border-radius: Metrics.radius-field;
                                    background: transparent;
                                    border-width: Metrics.border-thin; border-color: Theme.border-strong;
                                    accessible-role: button; accessible-label: @tr("No");
                                    accessible-action-default => { root.confirmation = ""; }
                                    Text { text: @tr("No"); color: Theme.text-secondary; font-size: Metrics.font-caption; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        moved => { root.inactive-ticks = 0; }
                                        clicked => { root.confirmation = ""; }
                                    }
                                }
                                if r.pinnable : Rectangle {
                                    height: 24px; x: 0px; y: (parent.height - self.height) / 2;
                                    width: parent.width; border-radius: Metrics.radius-field;
                                    border-width: root.is-pinned(r.id) ? 0px : Metrics.border-thin;
                                    border-color: pin-touch.has-hover ? Theme.accent : Theme.border-strong;
                                    background: root.is-pinned(r.id) ? Theme.accent
                                        : pin-touch.pressed || pin-touch.has-hover ? Theme.tint(Theme.accent) : transparent;
                                    accessible-role: button;
                                    accessible-label: r.name + ". " + (root.is-pinned(r.id) ? @tr("on the bar") : @tr("pin"));
                                    accessible-checkable: true; accessible-checked: root.is-pinned(r.id);
                                    accessible-action-default => {
                                        if (r.id != "restore" || root.can-restore-tile) {
                                            root.inactive-ticks = 0; root.pin-toggled(r.id);
                                        }
                                    }
                                    Text {
                                        text: root.is-pinned(r.id) ? @tr("on the bar") : @tr("pin");
                                        font-size: Metrics.font-caption; font-weight: root.is-pinned(r.id) ? 600 : 400;
                                        color: root.is-pinned(r.id) ? Theme.on-accent
                                            : pin-touch.pressed || pin-touch.has-hover ? Theme.on-tint(Theme.accent) : Theme.text-muted;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    pin-touch := TouchArea {
                                        enabled: r.id != "restore" || root.can-restore-tile;
                                        mouse-cursor: pointer;
                                        moved => { root.inactive-ticks = 0; }
                                        clicked => { root.inactive-ticks = 0; root.pin-toggled(r.id); }
                                    }
                                }
                            }
                        }
                        // One action hit region covers icon, name and shortcut;
                        // confirmation and pin cells keep their independent targets.
                        row-touch := TouchArea {
                            x: 0px; y: 0px; height: parent.height;
                            width: root.confirmation == r.id
                                ? parent.width - root.col-key - root.col-pin - 2 * root.col-gap - root.col-pad
                                : r.pinnable ? parent.width - root.col-pin - root.col-gap - root.col-pad
                                : parent.width;
                            enabled: !r.head && (r.id != "restore" || root.can-restore-tile);
                            mouse-cursor: pointer;
                            clicked => { root.choose(r.id); }
                            moved => { root.inactive-ticks = 0; }
                        }
                    }
                }
                if root.pin-error-ticks > 0 : Text {
                    height: root.footer-height;
                    text: @tr("Could not save. Try again.");
                    color: Theme.on-tint(Theme.danger); font-size: Metrics.font-label;
                    vertical-alignment: center; overflow: elide;
                }
            }
        }
    }
}
