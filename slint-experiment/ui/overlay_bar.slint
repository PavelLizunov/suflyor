// Capsule overlay bar. Rust retains ownership of capture/session state and actions.

import { Button, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Metrics } from "metrics.slint";
import { BarSpec } from "bar_spec.slint";

global OverlayCursorPolicy {
    in-out property <bool> force-arrow: false;
}

// ===== Reusable chip primitives =====

component IconSlot inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text-secondary;
    in property <length> glyph-size: 14px;
    in property <length> slot-width: 14px;
    in property <length> slot-height: 22px;
    width: slot-width;
    height: slot-height;
    horizontal-stretch: 0;

    Image {
        source: root.icon;
        colorize: root.tint;
        width: root.glyph-size;
        height: root.glyph-size;
        image-fit: contain;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component BrandStateMark inherits Rectangle {
    in property <bool> assistant-active: false;
    in property <length> mark-size: 22px;
    width: mark-size;
    height: mark-size;
    horizontal-stretch: 0;

    Image {
        source: root.assistant-active
            ? @image-url("../assets/brand-penguin.svg")
            : @image-url("../assets/brand-head.svg");
        colorize: Theme.text-primary;
        width: root.mark-size;
        height: root.mark-size;
        image-fit: contain;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Generic chip: rounded background + 1px border + small label, with
// an optional active state for the colored variant.
component Chip inherits Rectangle {
    in property <string> label;
    // Design-system icon (skia-safe line SVG, tinted by `colorize` to the
    // chip's semantic colour). When `has-icon` is set, the icon renders in
    // place of (or alongside) the text. Icon-only chips set `a11y` so screen
    // readers still get a word instead of a glyph.
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> a11y;
    in property <bool> active: false;
    in property <color> accent: Theme.accent;
    // Render the label in the mono font (Cascadia) — for the session timer so
    // the ticking digits don't shift width frame to frame.
    in property <bool> mono: false;

    // Toggle chips set this so assistive technology and the MCP audit can read
    // the state (`active`) instead of guessing it from the colour.
    in property <bool> checkable: false;

    callback clicked();

    accessible-role: button;
    accessible-label: a11y != "" ? a11y : label;
    accessible-checkable: checkable;
    accessible-checked: checkable && active;
    accessible-action-default => { root.clicked(); }

    // Hover + press feedback so a click is visibly registered. Action chips
    // (Stop / Expand / X …) had NO feedback at all — only the persistent
    // `active` toggle changed the background — so a click looked like nothing
    // happened (reported for the compact Stop). `active` still wins; otherwise
    // pressed flashes the accent, hover lifts a subtle fill.
    background: active
        ? accent.with-alpha(0.18)
        : (ta.pressed
            ? accent.with-alpha(0.34)
            : (ta.has-hover ? Theme.border-strong.with-alpha(0.22) : transparent));
    border-color: active ? accent : (ta.has-hover ? accent.with-alpha(0.6) : Theme.border-strong);
    border-width: Metrics.border-thin;
    border-radius: Metrics.radius-control;
    height: Metrics.control-md;
    horizontal-stretch: 0;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: Metrics.space-sm;
        padding-right: Metrics.space-sm;
        spacing: Metrics.space-xs;
        alignment: center;
        if root.has-icon : IconSlot {
            icon: root.icon;
            tint: active ? accent : Theme.text-secondary;
            glyph-size: 14px;
            slot-width: 14px;
            slot-height: 22px;
        }
        if root.label != "" : Text {
            text: label;
            font-family: root.mono ? Theme.font-mono : "";
            font-size: Metrics.font-label;
            color: active ? accent : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// Auto-tiles choices share their icons and semantic colours with the bar switch.
export component LockModeMenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    in property <color> mode-color: Theme.text-secondary;
    in property <image> icon;
    callback clicked();

    accessible-action-default => { root.clicked(); }

    height: 30px;
    border-radius: Metrics.radius-control;
    background: root.current ? root.mode-color.with-alpha(0.14) : (row-touch.has-hover ? Theme.bg-surface : transparent);
    border-width: root.current ? Metrics.border-thin : 0px;
    border-color: root.current ? root.mode-color.with-alpha(0.65) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.current;
    HorizontalLayout {
        padding-left: Metrics.space-sm;
        padding-right: Metrics.space-sm;
        spacing: Metrics.space-sm;
        Image {
            source: root.icon;
            colorize: root.mode-color;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.current ? root.mode-color : Theme.text-secondary;
            font-size: Metrics.font-label;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.current : Text {
            text: @tr("Current");
            color: root.mode-color;
            font-size: Metrics.font-label;
            vertical-alignment: center;
        }
    }
    row-touch := TouchArea {
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        clicked => { root.clicked(); }
    }
}

component AutotileChip inherits Rectangle {
    out property <bool> fits: lay.preferred-width <= self.width;
    in property <bool> tight: false;
    // Rust owns persistence; suppression wins over a stored every-line flag.
    in property <int> mode: 1;
    property <bool> locked: root.mode == 0;
    property <bool> unlocked: root.mode == 1;
    property <color> accent: root.mode == 2 ? Theme.cat-orange : Theme.warning;
    property <string> label: root.mode == 0 ? @tr("silent")
        : root.mode == 2 ? @tr("everything") : @tr("questions");
    property <string> a11y: root.mode == 0 ? @tr("Silent: no automatic tiles")
        : root.mode == 2 ? @tr("On every line") : @tr("On questions");
    callback menu-opened(length, length);
    property <bool> phase: false;

    accessible-role: button;
    accessible-label: root.a11y;
    accessible-checkable: true;
    accessible-checked: root.mode != 1;
    accessible-action-default => { root.menu-opened(root.absolute-position.x + root.width, root.absolute-position.y + root.height); }
    background: root.mode != 1
        ? Theme.tint(accent)
        : (ta.pressed
            ? accent.with-alpha(0.34)
            : (ta.has-hover ? Theme.border-strong.with-alpha(0.22) : transparent));
    border-color: locked ? accent : (ta.has-hover ? accent.with-alpha(0.6) : Theme.border-strong);
    border-width: 0px;
    border-radius: Metrics.radius-control;
    height: Metrics.control-md;
    min-width: 26px;
    horizontal-stretch: 0;
    animate background { duration: 80ms; }

    // Preserve the listening-mode tremble, independently of unloaded AI.
    Timer {
        interval: 90ms;
        running: root.locked;
        triggered => {
            root.phase = !root.phase;
        }
    }
    lay := HorizontalLayout {
        padding-left: Metrics.space-xs;
        padding-right: Metrics.space-xs;
        spacing: Metrics.space-xs;
        alignment: center;

        Image {
            source: root.mode == 2 ? @image-url("../assets/icons/flame.svg")
                : root.unlocked ? @image-url("../assets/icons/unlock.svg") : @image-url("../assets/icons/lock.svg");
            colorize: root.mode != 1 ? Theme.on-tint(root.accent) : Theme.text-secondary;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            // transform-rotation pivots around the element centre by default → a clean wobble.
            transform-rotation: root.locked ? (root.phase ? 7deg : -7deg) : 0deg;
            animate transform-rotation {
                duration: 85ms;
                easing: ease-in-out;
            }
        }
        if !root.tight : Text {
            text: root.label;
            font-size: Metrics.font-label;
            color: root.mode != 1 ? Theme.on-tint(root.accent) : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        // The old popup was clipped to the bar's 64px native client area. Rust
        // opens the separate LockModeMenuWindow at this chip's screen anchor.
        clicked => { root.menu-opened(root.absolute-position.x + root.width, root.absolute-position.y + root.height); }
    }
}

// Capsule children have stable slots and no individual outline.
component BarChip inherits Rectangle {
    in property <string> label;
    // Design-system icon (skia-safe line SVG, tinted by `colorize` to the
    // chip's semantic colour). When `has-icon` is set, the icon renders in
    // place of (or alongside) the text. Icon-only chips set `a11y` so screen
    // readers still get a word instead of a glyph.
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> a11y;
    in property <bool> active: false;
    in property <color> accent: Theme.accent;
    // Render the label in the mono font (Cascadia) — for the session timer so
    // the ticking digits don't shift width frame to frame.
    in property <bool> mono: false;

    // Toggle chips set this so assistive technology and the MCP audit can read
    // the state (`active`) instead of guessing it from the colour.
    in property <bool> checkable: false;
    in property <bool> checked: root.active;

    width: 26px;
    in property <bool> solid: false;
    callback clicked();

    accessible-role: button;
    accessible-label: a11y != "" ? a11y : label;
    accessible-checkable: checkable;
    accessible-checked: root.checkable && root.checked;
    accessible-action-default => { root.clicked(); }

    // State colour wins over press/hover feedback. The capsule owns the border.
    background: root.solid ? root.accent : active
        ? Theme.tint(accent)
        : (ta.pressed
            ? accent.with-alpha(0.34)
            : (ta.has-hover ? Theme.border-strong.with-alpha(0.22) : transparent));
    border-width: 0px;
    border-radius: Metrics.radius-control;
    height: Metrics.control-md;
    horizontal-stretch: 0;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: Metrics.space-xs;
        padding-right: Metrics.space-xs;
        spacing: Metrics.space-xs;
        alignment: center;
        if root.has-icon : IconSlot {
            icon: root.icon;
            tint: root.solid ? Theme.bg-surface : active ? Theme.on-tint(accent) : Theme.text-secondary;
            glyph-size: 14px;
            slot-width: 14px;
            slot-height: 22px;
        }
        if root.label != "" : Text {
            text: label;
            font-family: root.mono ? Theme.font-mono : "";
            font-size: Metrics.font-label;
            color: root.solid ? Theme.bg-surface : active ? Theme.on-tint(accent) : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        clicked => { root.clicked(); }
    }
}


// Second-row actions are bare: state is conveyed by the glyph, not a capsule.
component PinChip inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> a11y;
    in property <color> tint: Theme.text-secondary;
    in property <bool> action-enabled: true;
    in property <int> weight: 400;
    callback clicked();
    width: root.label == "" ? 26px : 86px;
    height: 22px;
    horizontal-stretch: 0;
    opacity: root.action-enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.a11y;
    accessible-action-default => { if (root.action-enabled) { root.clicked(); } }
    HorizontalLayout {
        alignment: center; spacing: Metrics.space-xs;
        IconSlot { icon: root.icon; tint: root.tint; }
        if root.label != "" : Text {
            text: root.label; color: root.tint; font-size: Metrics.font-caption; font-weight: root.weight;
            accessible-label: ""; // The parent exposes the single action label.
            vertical-alignment: center; overflow: elide; min-width: 0px;
        }
    }
    TouchArea {
        enabled: root.action-enabled;
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        clicked => { root.clicked(); }
    }
}

component MoreChip inherits Rectangle {
    in property <bool> active: false;
    in property <color> accent: Theme.accent;
    callback menu-opened(length, length);
    width: 26px; height: Metrics.control-md;
    horizontal-stretch: 0;
    border-radius: Metrics.radius-control;
    background: root.active ? Theme.tint(root.accent)
        : more-touch.pressed ? Theme.tint(root.accent)
        : more-touch.has-hover ? Theme.bg-surface : transparent;
    accessible-role: button;
    accessible-label: @tr("More");
    accessible-action-default => { root.menu-opened(root.absolute-position.x + root.width, root.absolute-position.y + root.height); }
    IconSlot {
        icon: @image-url("../assets/icons/more.svg");
        tint: root.active ? Theme.on-tint(root.accent) : Theme.text-secondary;
        x: (parent.width - self.width) / 2;
    }
    more-touch := TouchArea {
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        clicked => { root.menu-opened(root.absolute-position.x + root.width, root.absolute-position.y + root.height); }
    }
}

component Capsule inherits Rectangle {
    out property <bool> fits: lay.preferred-width <= self.width;
    height: 26px;
    border-radius: Metrics.radius-control;
    background: Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border;
    horizontal-stretch: 0;
    lay := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        alignment: start;
        @children
    }
}

// Phase E6 v42 — push-to-record button. HOLD to record: pointer-down
// fires `pressed`, pointer-up fires `released` (Slint grabs the pointer
// on press, so `up` lands here even if the cursor drifts off). Rust
// records the chosen source while held, then transcribes + asks AI on
// release. Turns red with a filled dot while `recording` (set by Rust);
// no ⏺ glyph — a Rectangle dot dodges the missing-glyph font issue.
component RecordBtn inherits Rectangle {
    in property <string> label;
    // Source icon (mic / speaker), tinted like the label.
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> accent: Theme.success;
    in property <bool> recording: false;
    callback pressed();
    callback released();

    // V0.8.4 — Telegram-style swipe-up-to-lock. Default flow is unchanged:
    // hold to record (pressed), release to send (released). NEW: while holding,
    // drag up past `lock-dy` → hands-free "locked" recording — releasing the
    // button no longer stops it (the chip becomes a STOP button: the dot turns
    // into a square; a fresh click stops + sends, reusing `released()`). Recording
    // is "record-until-released" in Rust, so locking just defers the released()
    // call — no Rust change needed. `press-y` is the pointer y at press; the
    // TouchArea grabs the pointer on press so `moved` keeps firing past the bounds.
    in-out property <bool> locked: false;
    property <length> press-y;
    property <bool> swallow-up: false;
    // Threshold kept small: the bar is pinned at the TOP of the screen, so the
    // cursor clamps at the screen edge ~43px above the chip — a larger threshold
    // would be unreachable without first moving the bar down.
    property <length> lock-dy: 24px;

    accessible-role: button;
    accessible-label: label;

    background: recording ? Theme.danger.with-alpha(0.2) : transparent;
    border-color: recording ? Theme.danger : Theme.border-strong;
    border-width: Metrics.border-thin;
    border-radius: Metrics.radius-control;
    height: Metrics.control-md;
    horizontal-stretch: 0;
    animate background, border-color { duration: Metrics.motion-fast; }

    // Reset the lock whenever recording ends from any cause (release, stop-click,
    // watchdog timeout) so the chip never gets stuck in the locked/stop look.
    changed recording => {
        if (!self.recording) {
            self.locked = false;
        }
    }

    HorizontalLayout {
        padding-left: Metrics.space-xs;
        padding-right: Metrics.space-xs;
        spacing: 2px;
        // Reserve the cell while idle; filled red while recording, square while locked.
        Rectangle {
            width: 8px;
            height: 8px;
            horizontal-stretch: 0;
            border-radius: root.locked ? 0px : 4px;
            y: (parent.height - self.height) / 2;
            background: root.recording ? Theme.danger : transparent;
            border-width: 0px;
        }
        if root.has-icon : IconSlot {
            icon: root.icon;
            tint: root.recording ? Theme.danger : Theme.text-secondary;
            glyph-size: 14px;
            slot-width: 14px;
            slot-height: 22px;
        }
        Text {
            text: root.label;
            font-size: Metrics.font-label;
            color: root.recording ? Theme.on-tint(Theme.danger) : Theme.text-secondary;
            font-weight: 600;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        IconSlot {
            opacity: root.recording ? 1 : 0;
            icon: root.locked
                ? @image-url("../assets/icons/stop.svg")
                : @image-url("../assets/icons/arrow-up.svg");
            tint: root.locked ? Theme.danger : Theme.warning;
            glyph-size: 12px;
            slot-width: 12px;
            slot-height: 22px;
        }
    }
    TouchArea {
        mouse-cursor: OverlayCursorPolicy.force-arrow ? default : pointer;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left) {
                if (ev.kind == PointerEventKind.down) {
                    if (root.locked) {
                        // Fresh click while locked = STOP (same as a release).
                        root.locked = false;
                        root.swallow-up = true;
                        root.released();
                    } else {
                        root.press-y = self.mouse-y;
                        root.swallow-up = false;
                        root.pressed();
                    }
                }
                if (ev.kind == PointerEventKind.up) {
                    if (root.swallow-up) {
                        root.swallow-up = false;
                    } else if (!root.locked) {
                        root.released();
                    }
                    // locked && !swallow-up = the release that follows a lock →
                    // keep recording hands-free (do nothing).
                }
            }
        }
        moved => {
            // Gate on `recording` so a chip whose recording never started (e.g.
            // the mic was busy → on_ptt_*_pressed bailed) can't show a locked /
            // stop look without actually recording.
            if (self.pressed && root.recording && !root.locked
                && root.press-y - self.mouse-y > root.lock-dy) {
                root.locked = true;
            }
        }
    }
}

// ===== Main overlay bar =====

// What the status pill is saying, named by the host. The bar turns it into a
// theme colour (see `status-color`).
export enum StatusTone { neutral, ok, warning, danger, info }

export component OverlayBarWindow inherits Window {
    // Phase 4 — keep std-widgets (Button etc.) dark with the active scheme
    // instead of Slint's light fluent default. See settings_panel for detail.
    property <bool> widgets-light: Theme.is-light;
    init => { Palette.color-scheme = root.widgets-light ? ColorScheme.light : ColorScheme.dark; }
    changed widgets-light => { Palette.color-scheme = root.widgets-light ? ColorScheme.light : ColorScheme.dark; }
    title: @tr("suflyor (Slint)");
    icon: @image-url("../assets/icon.svg");
    background: transparent;
    no-frame: true;
    always-on-top: true;
    preferred-width: root.bootstrap-mode ? 560px : (root.compact-bar ? BarSpec.compact-width : BarSpec.full-width);
    preferred-height: BarSpec.height;
    min-width: root.bootstrap-mode ? 440px : (root.compact-bar ? BarSpec.compact-width : BarSpec.full-width);
    out property <bool> autotile-word-fits: autotile-chip.fits;
    out property <bool> all-regions-fit: root.bootstrap-mode || (state-capsule.fits
        && voice-capsule.fits && session-capsule.fits && tiles-capsule.fits && window-capsule.fits);
    in-out property <bool> menu-open: false;
    callback menu-opened(length, length);
    callback menu-dismissed();
    function dismiss-menu() {
        root.menu-open = false;
        root.menu-dismissed();
    }
    in property <[string]> pins;
    callback pin-activated(string);
    pure function pin-icon(id: string) -> image {
        return id == "capture" ? @image-url("../assets/icons/camera.svg")
            : id == "restore" ? @image-url("../assets/icons/restore.svg")
            : id == "archive" ? @image-url("../assets/icons/archive.svg")
            : id == "summary" ? @image-url("../assets/icons/summary.svg")
            : id == "kb" ? @image-url("../assets/icons/kb.svg")
            : id == "settings" ? @image-url("../assets/icons/gear.svg")
            : id == "help" ? @image-url("../assets/icons/sos.svg")
            : @image-url("../assets/icons/tray.svg");
    }
    pure function pin-label(id: string) -> string {
        return id == "capture" ? @tr("Ask about a screenshot")
            : id == "restore" ? @tr("Restore closed tile")
            : id == "archive" ? @tr("Session archive")
            : id == "summary" ? @tr("Meeting summary")
            : id == "kb" ? @tr("Knowledge base")
            : id == "settings" ? @tr("Settings")
            : id == "help" ? @tr("Help") : @tr("Hide to tray");
    }
    pure function is-pinned(id: string) -> bool {
        return (root.pins.length > 0 && root.pins[0] == id)
            || (root.pins.length > 1 && root.pins[1] == id)
            || (root.pins.length > 2 && root.pins[2] == id)
            || (root.pins.length > 3 && root.pins[3] == id)
            || (root.pins.length > 4 && root.pins[4] == id)
            || (root.pins.length > 5 && root.pins[5] == id)
            || (root.pins.length > 6 && root.pins[6] == id)
            || (root.pins.length > 7 && root.pins[7] == id);
    }

    // Status pill text (idle / recording / etc).
    in-out property <string> status-text: "idle";
    // The host names the tone; the colour comes from the theme, so the pill
    // stays readable in every scheme.
    in-out property <StatusTone> status-tone: StatusTone.neutral;
    property <color> status-color: root.status-tone == StatusTone.ok ? Theme.success
        : root.status-tone == StatusTone.warning ? Theme.warning
        : root.status-tone == StatusTone.danger ? Theme.danger
        : root.status-tone == StatusTone.info ? Theme.accent
        : Theme.text-muted;
    // A verified stealth failure overrides the tone with the warning colour.
    property <color> pill-color: root.stealth-fault ? Theme.warning : root.status-color;

    // Live capture flags.
    in-out property <bool> mic-active: false;
    // v0.13.1 — mic muted (drops mic transcript + mic recording). Drives the
    // mic chip's slashed-icon + dimmed look.
    in-out property <bool> mic-muted: false;
    in-out property <bool> sys-active: false;

    // Session timer label (formatted by Rust, e.g. "03:42").
    in-out property <string> timer-label: "00:00";
    in-out property <bool> timer-active: false;
    // v0.22.0 — true while the running session is PAUSED. Drives the Pause
    // chip's play/pause icon + the frozen timer; set by Rust.
    in-out property <bool> session-paused: false;
    // v0.22.0 — the active session's short title (auto-named, later editable).
    // Shown next to the timer while a session runs; empty until the namer fills
    // it. Set by Rust (the bar tick mirrors SlintRuntime.session_name).
    in-out property <string> session-name: "";

    // Phase E10.2 — read-only "active stack" readout: which STT engine +
    // which AI model are actually live, with a 🟢 local / ☁ cloud / ◐ mixed
    // icon. So the user can tell at a glance what's transcribing + answering.
    in-out property <string> active-stack: "";
    // Current request phases (load/TTFT/total/decode/effective), polled from the
    // backend and appended to the active-stack footer. Empty after 30s so an old
    // fast request is never presented as the speed of current work.
    in-out property <string> tok-per-sec: "";
    // macOS process-footprint samples, formatted by Rust. The MLX value is the
    // sidecar's unified-memory process footprint, not discrete VRAM.
    in-out property <string> app-memory: "";
    in-out property <string> mlx-memory: "";

    // Tile counter for the "+ Tile" button.
    in-out property <int> tiles-spawned: 0;

    // #B1 — LIVE count of currently-open tiles (Rust keeps this in sync with
    // the TileWindows vec on every spawn/close). Drives the "tile · N" label
    // and gates the "close all" chip, so closing tiles via their own X buttons
    // updates the bar (tiles-spawned is a CUMULATIVE counter and must NOT be
    // used for these — it never decrements except on close-all).
    in-out property <int> open-tiles: 0;
    // One bounded recovery slot for a read-aloud tile closed by mistake.
    in-out property <bool> can-restore-tile: false;

    // Compatibility flags derived from the selected auto-tiles mode.
    in-out property <int> autotile-mode: 1;
    callback autotile-state-refreshed();
    in-out property <bool> aggressive-active: root.autotile-mode == 2;
    // E10.2 — stealth on/off, so the 🎯 chip lights up + reflects restored state.
    in-out property <bool> stealth-active: false;
    changed stealth-active => {
        OverlayCursorPolicy.force-arrow = root.stealth-active;
    }
    // I1/I4 — verified stealth FAILURE: a WDA apply/readback (or the F8 capture
    // overlay's HWND grab) failed, so the status pill shows the translated
    // generic failure text instead of the mic/sys status until the next apply
    // verifies. Set/cleared by Rust (surface_stealth_unavailable clears in
    // apply_bar_stealth); the pill TEXT is translated here so RU follows
    // ui_language (the pill's colour stays Rust-owned — colours don't translate).
    in-out property <bool> stealth-fault: false;
    property <string> presented-status: root.stealth-fault
        ? @tr("[!] stealth unavailable")
        : root.localized-status(root.status-text);
    // Rust sets these state words in English and compares against them, so
    // they are translated here, at the point of display. Any other text
    // (already localized by Rust) passes through unchanged.
    pure function localized-status(s: string) -> string {
        return s == "idle" ? @tr("idle") :
               s == "recording" ? @tr("recording") :
               s == "mic only" ? @tr("mic only") :
               s == "mic muted" ? @tr("mic muted") :
               s == "paused" ? @tr("paused") :
               s == "wrapping up" ? @tr("wrapping up") :
               s == "start failed" ? @tr("start failed") :
               s == "sys ok" ? @tr("sys ok") :
               s == "sys quiet" ? @tr("sys quiet") :
               s == "sys silent" ? @tr("sys silent") :
               s == "sys test failed" ? @tr("sys test failed") :
               s == "AI unavailable" ? @tr("AI unavailable") : s;
    }

    // Phase E6 v11 — live status indicators. `last-transcript-line`
    // shows the most recent STT output (truncated by Rust to ~120
    // chars) below the chip row so user sees "транскрипция работает".
    // `ai-streaming` lights up the AI model chip background pulse so
    // user sees "AI работает" while a tile is mid-stream.
    in-out property <string> last-transcript-line: "";
    in-out property <bool> ai-streaming: false;
    // Source tag for the transcript line — "mic" / "sys" / "" to
    // colour-code which side of the conversation it came from.
    in-out property <string> last-transcript-source: "";

    // Phase E6 v42 — push-to-record (hold) state. Rust flips these true
    // while the corresponding source is recording so the button glows red.
    in-out property <bool> mic-recording: false;
    in-out property <bool> sys-recording: false;

    // Phase E6 v45 — ⚙ Settings chip lights up while the Settings window
    // is open (Rust flips this on open / close). User: "значок настроек
    // не загорается когда настройки открыты".
    in-out property <bool> settings-open: false;
    in-out property <bool> help-open: false;
    // Phase 3a — lights the 🗄 archive chip while the archive window is open
    // (same as settings-open / help-open).
    in-out property <bool> archive-open: false;
    // Phase E6 v45 — X quit is two-step: first press arms an inline
    // "Quit? Yes/No" confirm (Rust auto-disarms after a few seconds) so a
    // stray click can't kill the app. User: "крестик моментально всё
    // закрывает без предупреждения".
    in-out property <bool> quit-armed: false;
    // V0.8.0 (Поток B) — emergency-restart inline confirm, same two-step UX.
    in-out property <bool> restart-armed: false;
    // v0.8.2 (M1 fix) — true while EITHER inline confirm (quit / restart) is
    // showing. The confirm expands the action row inline, so we hide the
    // secondary right-cluster chips (close-all / tile counter / 📷 / ⚙) while it's
    // up, keeping the row inside the fixed 1080px bar. Before this, RU
    // "Перезапустить? Да Нет" + the "close all" chip + the wide "⚠ AI
    // недоступен" status pushed "Нет" (cancel) off the right edge — exactly in
    // the restart-while-AI-down flow the feature exists for. The un-armed bar
    // is pixel-identical to before (chips only hide during the ≤4s confirm).
    property <bool> confirming: root.quit-armed || root.restart-armed;
    // Retained legacy state for host compatibility; these controls move to the menu.
    property <bool> tight-open-tiles: root.open-tiles > 0;

    // v0.12.0 — true while a Summary request is in flight. Lights the 📝
    // chip AND doubles as the Rust-side re-click guard (a slow model must
    // not stack parallel summary calls).
    in-out property <bool> summary-busy: false;

    // ===== Compact "reader mode" =====
    // Collapse the wide bar to a narrow session strip (status pill + спросить /
    // захватить + timer + Expand). Persisted via config.compact_bar; Rust resizes
    // the bar window on toggle.
    in-out property <bool> compact-bar: false;
    changed compact-bar => { root.dismiss-menu(); }
    // macOS production bootstrap: keep the real product bar/window while its
    // platform adapters are connected, but never expose dead AI/audio controls.
    in property <bool> bootstrap-mode: false;
    // macOS bootstrap only: raw AVFoundation authorization status
    // (0 not determined, 1 restricted, 2 denied, 3 authorized, 4 requesting).
    in-out property <int> mic-permission-state: 0;
    // macOS bootstrap only: 0 stopped, 1 receiving native audio, 2 start failed.
    in-out property <int> mic-capture-state: 0;
    // The hide action is exposed only after Windows accepted the tray icon;
    // otherwise hiding the bar would remove the only restore surface.
    in property <bool> tray-available: false;
    in-out property <bool> suppress-tiles: root.autotile-mode == 0;
    // Independent managed-local lifecycle state: AI is unloaded and requests refused.
    // Implies suppress-tiles (Rust keeps the two consistent).
    in-out property <bool> deep-lock: false;
    // Runtime-testable state that directly drives the lock chip's rendered icon.
    out property <bool> lock-icon-unlocked: root.autotile-mode == 1;
    // Existing long deep-state description for the unloaded-AI indicator.
    in property <string> lock-a11y: "";
    in property <bool> lock-menu-managed: false;

    // ===== Callbacks =====
    callback mic-toggle-clicked();
    callback lock-menu-opened(length, length);
    callback sys-toggle-clicked();
    // Phase E6 v42 — push-to-record hold callbacks (down = start, up = stop).
    callback ptt-mic-pressed();
    callback ptt-mic-released();
    callback ptt-sys-pressed();
    callback ptt-sys-released();
    callback timer-toggle-clicked();
    // v0.22.0 — Pause/Resume the running session (keeps the SAME session).
    callback pause-toggle-clicked();
    callback spawn-tile-clicked();
    // V0.8.3 — "Написать": open the typed-question input window.
    callback text-ask-clicked();
    callback close-all-tiles-clicked();
    callback restore-tile-clicked();
    callback capture-clicked(); // 📷 screenshot -> vision (same as F8)
    callback stealth-toggle-clicked();
    callback autotile-mode-selected(int); // 0=silent, 1=questions, 2=every line
    callback local-ai-mode-selected(int); // 0=load, 1=load silent, 2=unload, 3=load every line, 4=load questions
    callback open-settings-clicked();
    callback help-clicked();   // 🆘 chip / F1 → open the help window
    callback archive-clicked(); // 🗄 chip / F7 → open the session archive
    callback summary-clicked(); // v0.12.0 — 📝 chip → meeting-summary tile
    callback quit-clicked();   // X pressed → Rust arms the inline confirm
    // V0.8.0 (Поток B) — emergency restart (⟳). Two-step like Quit.
    callback restart-clicked();
    callback restart-confirm();
    callback restart-cancel();
    callback quit-confirm();   // "Yes" → really quit the app
    callback quit-cancel();    // "No" → disarm the confirm
    // Phase E6 v22 — manual cursor-delta drag (replaces modal
    // WM_NCLBUTTONDOWN which left TouchArea stuck pressed). down →
    // drag-start-requested (anchor), move-while-pressed → drag-moved.
    callback drag-start-requested();
    callback drag-moved();
    // Compact mode: collapse/expand the bar.
    callback compact-toggle-clicked();
    // RC4 — hide the bar to the system tray (explicit only; startup is always
    // visible). Recording/hotkeys/TTS keep running; the tray restores the bar.
    callback hide-to-tray-clicked();

    Rectangle {
        background: Theme.bg-surface.with-alpha(0.92);
        border-radius: Metrics.radius-panel;
        border-width: 1px;
        border-color: Theme.border;

        // One set of named capsules serves both layouts and exposes fit evidence.
        Rectangle {
            visible: !root.bootstrap-mode;
            width: parent.width; height: parent.height;
            Rectangle {
                x: BarSpec.pad; y: (parent.height - self.height) / 2;
                width: BarSpec.badge; height: BarSpec.badge;
                border-radius: self.width / 2;
                background: Theme.bg-elevated;
                border-width: 2px;
                border-color: root.stealth-fault ? Theme.danger : root.status-color;
                accessible-role: text;
                accessible-label: root.presented-status + ". " + @tr("Drag to move the bar; shows the live state");
                BrandStateMark {
                    assistant-active: root.ai-streaming; mark-size: 34px;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                }
                TouchArea {
                    mouse-cursor: OverlayCursorPolicy.force-arrow ? default : grab;
                    pointer-event(ev) => {
                        if (ev.button == PointerEventButton.left
                            && ev.kind == PointerEventKind.down) {
                            root.dismiss-menu(); root.drag-start-requested();
                        }
                    }
                    moved => {
                        if (self.pressed) { root.dismiss-menu(); root.drag-moved(); }
                    }
                }
            }
            VerticalLayout {
                x: BarSpec.pad + BarSpec.badge + BarSpec.pad;
                width: parent.width - self.x - BarSpec.pad;
                padding-top: 6px; padding-bottom: 6px; spacing: Metrics.space-xs;
                HorizontalLayout {
                    height: 26px; spacing: BarSpec.gap;
                    state-capsule := Capsule {
                        width: root.compact-bar ? BarSpec.compact-state : BarSpec.full-state;
                        BarChip {
                            width: root.compact-bar ? 26px : 70px;
                            icon: @image-url("../assets/icons/stealth.svg"); has-icon: true;
                            label: root.compact-bar ? "" : root.stealth-fault ? @tr("visible!")
                                : root.stealth-active ? @tr("hidden") : @tr("visible");
                            a11y: @tr("Stealth (hide from capture)");
                            active: root.stealth-active; checkable: true;
                            solid: root.stealth-fault;
                            accent: root.stealth-fault ? Theme.danger : Theme.cat-pink;
                            clicked => { root.dismiss-menu(); root.stealth-toggle-clicked(); }
                        }
                        if !root.compact-bar : BarChip {
                            icon: root.mic-muted ? @image-url("../assets/icons/micslash.svg") : @image-url("../assets/icons/mic.svg");
                            has-icon: true;
                            a11y: root.mic-muted ? @tr("Mic muted (click to unmute)") : @tr("Mic live (click to mute)");
                            active: root.mic-muted; accent: Theme.danger;
                            checkable: true; checked: !root.mic-muted;
                            clicked => { root.dismiss-menu(); root.mic-toggle-clicked(); }
                        }
                        if !root.compact-bar : BarChip {
                            icon: @image-url("../assets/icons/system-audio.svg"); has-icon: true;
                            a11y: @tr("System audio capture");
                            active: !root.sys-active; accent: Theme.danger;
                            checkable: true; checked: root.sys-active;
                            clicked => { root.dismiss-menu(); root.sys-toggle-clicked(); }
                        }
                    }
                    voice-capsule := Capsule {
                        width: root.compact-bar ? BarSpec.compact-voice : BarSpec.full-voice;
                        RecordBtn {
                            width: 102px;
                            icon: @image-url("../assets/icons/mic.svg"); has-icon: true;
                            label: @tr("ask"); accent: Theme.success; recording: root.mic-recording;
                            pressed => { root.dismiss-menu(); root.ptt-mic-pressed(); }
                            released => { root.dismiss-menu(); root.ptt-mic-released(); }
                        }
                        RecordBtn {
                            width: 108px;
                            icon: @image-url("../assets/icons/system-audio.svg"); has-icon: true;
                            label: @tr("grab"); accent: Theme.accent; recording: root.sys-recording;
                            pressed => { root.dismiss-menu(); root.ptt-sys-pressed(); }
                            released => { root.dismiss-menu(); root.ptt-sys-released(); }
                        }
                    }
                    session-capsule := Capsule {
                        width: root.compact-bar ? BarSpec.compact-session : BarSpec.full-session;
                        BarChip {
                            width: 82px;
                            icon: root.timer-active ? @image-url("../assets/icons/stop.svg") : @image-url("../assets/icons/session-start.svg");
                            has-icon: true;
                            label: root.timer-active ? root.timer-label : @tr("start"); mono: true;
                            checkable: true; checked: root.timer-active;
                            clicked => { root.dismiss-menu(); root.timer-toggle-clicked(); }
                        }
                        Rectangle {
                            width: 26px; height: Metrics.control-md; horizontal-stretch: 0;
                            if root.timer-active : BarChip {
                                icon: root.session-paused ? @image-url("../assets/icons/play.svg") : @image-url("../assets/icons/pause.svg");
                                has-icon: true;
                                a11y: root.session-paused ? @tr("Resume the session") : @tr("Pause the session");
                                active: root.session-paused; checkable: true; accent: Theme.warning;
                                clicked => { root.dismiss-menu(); root.pause-toggle-clicked(); }
                            }
                        }
                    }
                    tiles-capsule := Capsule {
                        width: root.compact-bar ? BarSpec.compact-tiles : BarSpec.full-tiles;
                        autotile-chip := AutotileChip {
                            width: root.compact-bar ? 26px : 96px;
                            tight: root.compact-bar;
                            mode: root.autotile-mode;
                            menu-opened(x, y) => { root.dismiss-menu(); root.lock-menu-opened(x, y); }
                        }
                        if !root.compact-bar : BarChip {
                            width: 92px;
                            icon: @image-url("../assets/icons/plus.svg"); has-icon: true;
                            label: @tr("tile · {}", root.open-tiles);
                            a11y: @tr("New tile, {} open", root.open-tiles);
                            clicked => { root.dismiss-menu(); root.spawn-tile-clicked(); }
                        }
                        if !root.compact-bar : Rectangle {
                            width: 22px; height: Metrics.control-md; horizontal-stretch: 0;
                            if root.open-tiles > 0 : BarChip {
                                width: 22px;
                                icon: @image-url("../assets/icons/x.svg"); has-icon: true;
                                a11y: @tr("close all");
                                clicked => { root.dismiss-menu(); root.close-all-tiles-clicked(); }
                            }
                        }
                        if !root.compact-bar : BarChip {
                            icon: @image-url("../assets/icons/pencil.svg"); has-icon: true;
                            a11y: @tr("Write a question");
                            clicked => { root.dismiss-menu(); root.text-ask-clicked(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: BarSpec.spring; }
                    window-capsule := Capsule {
                        width: root.compact-bar ? BarSpec.compact-window : BarSpec.full-window;
                        if root.compact-bar : Rectangle {
                            width: 26px; height: Metrics.control-md; horizontal-stretch: 0;
                            if root.tray-available : BarChip {
                                icon: @image-url("../assets/icons/tray.svg"); has-icon: true;
                                a11y: @tr("Hide to tray");
                                clicked => { root.dismiss-menu(); root.hide-to-tray-clicked(); }
                            }
                        }
                        BarChip {
                            icon: root.compact-bar ? @image-url("../assets/icons/maximize.svg") : @image-url("../assets/icons/minimize.svg");
                            has-icon: true;
                            a11y: root.compact-bar ? @tr("Expand the bar") : @tr("Compact reader mode");
                            clicked => { root.dismiss-menu(); root.compact-toggle-clicked(); }
                        }
                        more-chip := MoreChip {
                            active: root.menu-open; accent: Theme.accent;
                            menu-opened(x, y) => { root.menu-opened(x, y); }
                        }
                    }
                }
                // Bottom row: only real abnormalities and non-empty transcript data.
                HorizontalLayout {
                    height: Metrics.control-md; spacing: BarSpec.gap; padding-left: Metrics.space-xs;
                    if root.stealth-fault || root.status-tone == StatusTone.warning || root.status-tone == StatusTone.danger : Text {
                        text: root.presented-status;
                        font-size: Metrics.font-label; font-weight: 600;
                        color: Theme.on-tint(root.pill-color); vertical-alignment: center;
                        overflow: elide; max-width: parent.width / 2; horizontal-stretch: 0;
                    }
                    if root.deep-lock : PinChip {
                        width: 70px;
                        icon: @image-url("../assets/icons/lock.svg");
                        label: @tr("AI off"); a11y: root.lock-a11y;
                        tint: Theme.on-tint(Theme.danger); weight: 600;
                        clicked => { root.dismiss-menu(); root.local-ai-mode-selected(0); }
                    }
                    if root.timer-active && root.session-name != "" : Text {
                        text: root.session-name;
                        font-size: Metrics.font-label; font-weight: 600;
                        color: Theme.text-secondary; vertical-alignment: center;
                        overflow: elide; max-width: parent.width / 3; horizontal-stretch: 0;
                    }
                    if root.last-transcript-line != "" && (root.last-transcript-source == "mic" || root.last-transcript-source == "sys") : Text {
                        text: root.last-transcript-source == "mic" ? @tr("you:") : @tr("them:");
                        font-size: Metrics.font-label; font-weight: 600;
                        color: Theme.on-tint(root.last-transcript-source == "mic" ? Theme.success : Theme.accent);
                        vertical-alignment: center; horizontal-stretch: 0;
                    }
                    Text {
                        text: root.last-transcript-line;
                        font-size: Metrics.font-label; color: Theme.text-secondary;
                        overflow: elide; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px;
                    }
                    if !root.compact-bar && root.can-restore-tile && !root.is-pinned("restore") : PinChip {
                        icon: @image-url("../assets/icons/restore.svg");
                        a11y: @tr("Restore last tile");
                        clicked => { root.dismiss-menu(); root.restore-tile-clicked(); }
                    }
                    if root.app-memory != "" : Text {
                        text: @tr("App RAM") + " " + root.app-memory;
                        font-size: Metrics.font-caption; color: Theme.text-muted;
                        vertical-alignment: center; horizontal-stretch: 0;
                    }
                    if root.mlx-memory != "" : Text {
                        text: "MLX" + " " + root.mlx-memory;
                        font-size: Metrics.font-caption; color: Theme.text-muted;
                        vertical-alignment: center; horizontal-stretch: 0;
                    }
                    if !root.compact-bar : HorizontalLayout {
                        spacing: BarSpec.gap; horizontal-stretch: 0;
                        for id in root.pins : PinChip {
                            icon: root.pin-icon(id); a11y: root.pin-label(id);
                            action-enabled: (id != "restore" || root.can-restore-tile)
                                && (id != "tray" || root.tray-available);
                            tint: (id == "archive" && root.archive-open)
                                    || (id == "settings" && root.settings-open)
                                    || (id == "help" && root.help-open)
                                    || (id == "summary" && root.summary-busy) ? Theme.accent : Theme.text-secondary;
                            clicked => { root.dismiss-menu(); root.pin-activated(id); }
                        }
                        if root.pins.length == 0 : PinChip {
                            icon: @image-url("../assets/icons/plus.svg"); label: @tr("pin"); a11y: @tr("pin");
                            tint: Theme.text-muted; opacity: 0.7;
                            clicked => { root.menu-opened(more-chip.absolute-position.x + more-chip.width, more-chip.absolute-position.y + more-chip.height); }
                        }
                    }
                }
            }
        }

        // First honest production surface on macOS. The normal product bar is
        // hidden in this mode until its callbacks have real platform adapters.
        if root.bootstrap-mode : VerticalLayout {
            padding: Metrics.space-sm;
            spacing: Metrics.space-xs;

            HorizontalLayout {
                spacing: Metrics.space-md;

                Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: text;
                    accessible-label: @tr("Suflyor for macOS") + ". "
                        + @tr("Native overlay ready; product features are being connected.");
                    TouchArea {
                        mouse-cursor: grab;
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left
                                && ev.kind == PointerEventKind.down) {
                                root.dismiss-menu(); root.drag-start-requested();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Metrics.space-sm;
                        BrandStateMark { mark-size: 26px; }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: @tr("Suflyor for macOS");
                                color: Theme.text-primary;
                                font-size: Metrics.font-body;
                                font-weight: 700;
                            }
                            Text {
                                text: @tr("Native overlay ready; product features are being connected.");
                                color: Theme.text-secondary;
                                font-size: Metrics.font-label;
                                overflow: elide;
                            }
                        }
                    }
                }

                // The only product controls with real macOS adapters so far.
                Chip {
                    label: root.mic-permission-state == 3
                        ? (root.mic-capture-state == 1 ? @tr("Mic live")
                        : (root.mic-capture-state == 2 ? @tr("Mic failed") : @tr("Start mic")))
                        : (root.mic-permission-state == 4 ? @tr("Requesting...")
                        : ((root.mic-permission-state == 1 || root.mic-permission-state == 2)
                        ? @tr("Mic denied") : @tr("Allow mic")));
                    a11y: self.label;
                    height: 24px;
                    active: root.mic-capture-state == 1;
                    accent: (root.mic-permission-state == 1 || root.mic-permission-state == 2)
                        || root.mic-capture-state == 2 ? Theme.danger
                        : (root.mic-capture-state == 1 ? Theme.success : Theme.accent);
                    accessible-action-default => { root.dismiss-menu(); root.mic-toggle-clicked(); }
                    clicked => { root.dismiss-menu(); root.mic-toggle-clicked(); }
                }
                Chip {
                    label: @tr("Ask");
                    height: 24px;
                    accessible-action-default => { root.dismiss-menu(); root.text-ask-clicked(); }
                    clicked => { root.dismiss-menu(); root.text-ask-clicked(); }
                }
                Chip {
                    label: @tr("AI setup");
                    height: 24px;
                    accessible-action-default => { root.dismiss-menu(); root.open-settings-clicked(); }
                    clicked => { root.dismiss-menu(); root.open-settings-clicked(); }
                }

                Chip {
                    label: @tr("Quit");
                    accent: Theme.danger;
                    height: 24px;
                    accessible-action-default => { root.dismiss-menu(); root.quit-confirm(); }
                    clicked => { root.dismiss-menu(); root.quit-confirm(); }
                }
            }

            // One compact transcript/status row — the same latest-line
            // readout the normal bars show (dot = source tag, text = the
            // newest STT line; the placeholder stays until the first line).
            HorizontalLayout {
                padding-left: Metrics.space-xs;
                padding-right: Metrics.space-xs;
                spacing: 6px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.last-transcript-source == "mic"
                        ? Theme.success
                        : (root.last-transcript-source == "sys" ? Theme.accent : Theme.border-strong);
                }
                Text {
                    text: root.last-transcript-line == ""
                        ? @tr("waiting for transcript... (mic/sys → STT)")
                        : root.last-transcript-line;
                    font-size: Metrics.font-label;
                    color: root.last-transcript-line == "" ? Theme.text-muted : Theme.text-secondary;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
