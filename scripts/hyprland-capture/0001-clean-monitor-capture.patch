+SP<Render::ITexture> CScreenshareFrame::renderMonitorScene(PHLMONITOR PMONITOR) {
+    auto& renderer = *g_pHyprRenderer;
+    const auto OLD_DATA = renderer.m_renderData;
+    const bool OLD_SKIP = renderer.m_skipNoScreenShare;
+    const bool OLD_FEEDBACK = renderer.m_bBlockSurfaceFeedback;
+    const bool OLD_BLUR_QUEUED = PMONITOR->m_blurFBShouldRender;
+    Hyprutils::Utils::CScopeGuard restore([&] {
+        renderer.m_skipNoScreenShare = OLD_SKIP;
+        renderer.m_bBlockSurfaceFeedback = OLD_FEEDBACK;
+        PMONITOR->m_blurFBShouldRender = OLD_BLUR_QUEUED;
+        renderer.m_renderData = OLD_DATA;
+        renderer.bindFB(OLD_DATA.currentFB);
+        renderer.setViewport(0, 0, m_bufferSize.x, m_bufferSize.y);
+    });
+
+    // Render at native output size before applying the existing export transform and region crop.
+    // Keep this framebuffer private: display/mirror and optimized blur caches must stay untouched.
+    if (!m_session->m_captureFB) {
+        m_session->m_captureFB = renderer.createFB("capture scene without no_screen_share");
+        m_session->m_captureFB->addStencil(renderer.createStencilTexture(PMONITOR->m_pixelSize.x, PMONITOR->m_pixelSize.y));
+    }
+    const auto FB = m_session->m_captureFB;
+    if (!FB->alloc(PMONITOR->m_pixelSize.x, PMONITOR->m_pixelSize.y, OLD_DATA.currentFB->m_drmFormat))
+        return nullptr;
+    FB->setImageDescription(OLD_DATA.currentFB->imageDescription());
+
+    renderer.bindFB(FB);
+    renderer.m_renderData.mainFB = FB;
+    renderer.m_renderData.fbSize = PMONITOR->m_pixelSize;
+    renderer.m_renderData.damage = CRegion{0, 0, PMONITOR->m_transformedSize.x, PMONITOR->m_transformedSize.y};
+    renderer.m_renderData.finalDamage = renderer.m_renderData.damage;
+    renderer.m_renderData.renderModif = {};
+    renderer.m_renderData.clipBox = {};
+    renderer.m_renderData.transformDamage = true;
+    renderer.m_renderData.noSimplify = true;
+    renderer.setProjectionType(Render::RPT_MONITOR);
+    renderer.setViewport(0, 0, PMONITOR->m_pixelSize.x, PMONITOR->m_pixelSize.y);
+    renderer.m_skipNoScreenShare = true;
+    renderer.m_bBlockSurfaceFeedback = true;
+
+    renderer.draw(CClearPassElement::SClearData{{0, 0, 0, 0}}, renderer.m_renderData.damage);
+    const auto NOW = Time::steadyNow();
+    const CBox RENDERBOX = {{}, PMONITOR->m_pixelSize};
+    renderer.renderWorkspace(PMONITOR, PMONITOR->m_activeWorkspace, NOW, RENDERBOX);
+    renderer.renderLockscreen(PMONITOR, NOW, RENDERBOX);
+    renderer.renderIME(PMONITOR, NOW, RENDERBOX);
+    renderer.m_renderPass.render(renderer.m_renderData.damage);
+    renderer.m_renderPass.clear();
+    return FB->getTexture();
+}
